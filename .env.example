# Copy to .env for local use. Never commit .env.
# 示例文件可提交；复制后的 .env 存放本机密钥，必须保持在 Git 忽略列表中。
PERSONA_ENV=development
PERSONA_MODE=mock
# Origin 包含协议、主机和端口，应与用户访问地址一致；生产环境要求 HTTPS。
PERSONA_ORIGIN=http://127.0.0.1:8770
DATABASE_URL=sqlite:///memory/persona.sqlite3
PERSONA_INVITE_CODE=
PERSONA_PROVIDER_LABEL=Local demo
PERSONA_PRIVACY_CONTACT=
# 后端读取模型凭证。更改配置后重启；mock 模式不会消耗此密钥的额度。
PERSONA_API_KEY=
RELATIONSHIP_MODEL=glm-5.3
RELATIONSHIP_PROTOCOL=chat-completions
RELATIONSHIP_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 调用数包含 HTTP 重试；美元预留是本项目的保守限额，不是供应商账单余额。
PERSONA_USER_DAILY_CALLS=40
PERSONA_GLOBAL_DAILY_CALLS=200
PERSONA_DAILY_BUDGET_USD=2
# Conservative reservation per HTTP model attempt, never refunded, including failures.
PERSONA_REQUEST_RESERVE_USD=0.05
# REQUIRED in production: enter current provider prices in USD per million tokens.
PERSONA_INPUT_USD_PER_MILLION=0
PERSONA_OUTPUT_USD_PER_MILLION=0
# Only needed for Docker Compose:
PERSONA_DOMAIN=
POSTGRES_PASSWORD=
# Optional paid academic search; leave blank until needed.
# 检索凭证与模型密钥独立；不配置的服务能否使用由 academic.py 决定。
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Backups: Fernet key, separate from the database and backup storage.
PERSONA_BACKUP_KEY=
